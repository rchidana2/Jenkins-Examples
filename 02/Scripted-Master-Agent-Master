pipeline {
    agent none

    stages {

        stage('Run on Master') {
            agent {
                label 'master'
            }

            steps {
                echo "Running on Jenkins Master/Controller"
                echo "Node: ${env.NODE_NAME}"
            }
        }

        stage('Run on Windows Node') {
            agent {
                label 'Windows_Node'
            }

            steps {
                echo "Running on Windows_Node"
                echo "Node: ${env.NODE_NAME}"

                sleep time: 30, unit: 'SECONDS'

                echo "30 seconds completed on Windows_Node"
            }
        }

        stage('Back to Master') {
            agent {
                label 'master'
            }

            steps {
                echo "Back on Jenkins Master/Controller"
                echo "Node: ${env.NODE_NAME}"
            }
        }
    }
}

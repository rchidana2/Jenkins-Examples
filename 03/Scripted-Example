node('master') {

    stage('Checkout on Master') {

        echo "Running on: ${env.NODE_NAME}"

        // Checkout GitHub repository
        git branch: 'main',
           url: 'https://github.com/rchidana2/master-agent-example.git'

        echo "Source code checked out"

        sh 'chmod +x hello.sh'
        sh './hello.sh'

        // Make ONLY welcome.bat available to Windows_Node
        stash name: 'welcome-bat',
              includes: 'welcome.bat'
    }
}


node('Windows_Node') {

    stage('Execute on Windows Node') {

        echo "Running on: ${env.NODE_NAME}"

        // Retrieve only welcome.bat
        unstash 'welcome-bat'

        echo "Executing welcome.bat"

        bat 'welcome.bat'

        // Create a result
        bat '''
            echo Windows_Node execution completed successfully > result.txt
        '''

        // Send result back to Master
        stash name: 'windows-result',
              includes: 'result.txt'
    }
}


node('master') {

    stage('Process Result on Master') {

        echo "Running on: ${env.NODE_NAME}"

        // Retrieve result generated by Windows_Node
        unstash 'windows-result'

        echo "Result received from Windows_Node:"

        sh 'cat result.txt'
    }
}
